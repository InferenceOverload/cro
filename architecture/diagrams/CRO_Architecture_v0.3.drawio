        <mxCell id="_x0" value="&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;REQUEST PATH&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1&amp;nbsp;&amp;nbsp; Handler opens CRO UI (WAF, CloudFront, S3 SPA)&lt;br&gt;2&amp;nbsp;&amp;nbsp; Cognito redirects to Entra ID SSO; token carries&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; user id and AD group membership&lt;br&gt;3&amp;nbsp;&amp;nbsp; SPA calls API with JWT; authorizer verifies token&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; and requires AD group CRO-Handlers&lt;br&gt;4&amp;nbsp;&amp;nbsp; API Lambda: flag = Y, claim age &amp;gt;= 30 days,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; handler entitlement, data version vs summary, lock&lt;br&gt;5&amp;nbsp;&amp;nbsp; Unchanged: return stored summary. Changed: enqueue&lt;br&gt;6&amp;nbsp;&amp;nbsp; Worker Lambda picks up job (concurrency capped)&lt;br&gt;7&amp;nbsp;&amp;nbsp; Writes immutable input snapshot to S3&lt;br&gt;8&amp;nbsp;&amp;nbsp; Invokes Agent Engine using WIF (no stored keys)&lt;br&gt;9&amp;nbsp;&amp;nbsp; Agent calls Gemini; trace and thought summary logged&lt;br&gt;10&amp;nbsp;&amp;nbsp;Stores summary vN (append-only), releases lock&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;INGEST PATH&lt;/font&gt;&lt;/b&gt;&lt;br&gt;A&amp;nbsp;&amp;nbsp; Streams capture changes to claim and role products&lt;br&gt;B&amp;nbsp;&amp;nbsp; Task runs only when stream has data; unloads to S3&lt;br&gt;C&amp;nbsp;&amp;nbsp; S3 event to SQS; Ingest Lambda processes the batch&lt;br&gt;D&amp;nbsp;&amp;nbsp; Upserts claim items and handler entitlement items&lt;br&gt;E&amp;nbsp;&amp;nbsp; Optional: summaries to Snowflake through Snowpipe&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;SECURITY BASELINE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;SSO + AD group via Entra ID; no local users or passwords&lt;br&gt;No public endpoint; KMS CMKs; TLS everywhere&lt;br&gt;Every summary view written to the audit log&lt;br&gt;Dashed line: config, auth, error or optional path&lt;br&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1310" y="620" width="360" height="470" as="geometry" />
        </mxCell>
      </root>
