        <mxCell id="_x0" value="&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;FOUR LAYERS OF CONTROL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;L1&amp;nbsp;&amp;nbsp;Authentication: Azure AD SSO (PKCE, device PRT).&lt;br&gt;L2&amp;nbsp;&amp;nbsp;App access: AD group CRO-Handlers, checked in the&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Lambda Authorizer before any business code runs.&lt;br&gt;L3&amp;nbsp;&amp;nbsp;Claim access: the same authorizer compares ENT#&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; for the caller with CLAIM# for the request.&lt;br&gt;L4&amp;nbsp;&amp;nbsp;Audit: every allow / deny decision is logged.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;FLOW&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1&amp;nbsp;&amp;nbsp; SPA starts PKCE login; device SSO, no prompt&lt;br&gt;2&amp;nbsp;&amp;nbsp; Access token returned to the SPA (sub, groups)&lt;br&gt;3&amp;nbsp;&amp;nbsp; Every API call carries the bearer token&lt;br&gt;4&amp;nbsp;&amp;nbsp; Gateway invokes the Lambda Authorizer&lt;br&gt;5&amp;nbsp;&amp;nbsp; Signature checked against Azure AD JWKS (cached)&lt;br&gt;6&amp;nbsp;&amp;nbsp; Authorizer reads ENT# and CLAIM#, applies rule&lt;br&gt;7&amp;nbsp;&amp;nbsp; Allow: IAM policy admits the call to API Lambda&lt;br&gt;8&amp;nbsp;&amp;nbsp; Decision and summary version logged&lt;br&gt;A&amp;nbsp;&amp;nbsp; Role product changes captured like claims&lt;br&gt;B-D Same ingest path; ENT# items upserted&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;L3 RULE (configurable, Parameter Store)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Allow when any of:&lt;br&gt;&amp;nbsp;&amp;nbsp;user is the assigned adjuster / supervisor&lt;br&gt;&amp;nbsp;&amp;nbsp;user LOB and office match the claim&lt;br&gt;&amp;nbsp;&amp;nbsp;user role has secured-claim access, if secured&lt;br&gt;Otherwise Deny: 403, claim number not confirmed.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;PATTERN NOTE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;SPA_Internal_04 allows a separate Authorize API.&lt;br&gt;CRO folds it into the authorizer (two reads); it can&lt;br&gt;be split out later without changing the API.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;FRESHNESS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Entitlements lag Snowflake by the feed latency&lt;br&gt;(5 to 25 min). Removing the AD group in Entra&lt;br&gt;revokes access at the next token refresh.&lt;br&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1310" y="120" width="360" height="600" as="geometry" />
        </mxCell>
        <mxCell id="_x1" value="&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;LEGEND&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=12;container=1;collapsible=0;spacingTop=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="410" y="700" width="870" height="90" as="geometry" />
        </mxCell>
