        <mxCell id="_x0" value="&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;REQUEST PATH&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1&amp;nbsp;&amp;nbsp; Handler opens app.&amp;lt;domain&amp;gt; over Direct Connect&lt;br&gt;2&amp;nbsp;&amp;nbsp; Private API Gateway serves the SPA bundle from S3&lt;br&gt;3&amp;nbsp;&amp;nbsp; MSAL.js: OAuth 2.0 + PKCE; Azure AD SSO (device PRT)&lt;br&gt;4&amp;nbsp;&amp;nbsp; Every API call carries the Azure AD access token&lt;br&gt;5&amp;nbsp;&amp;nbsp; Lambda Authorizer: JWT (JWKS, iss, aud, exp, group)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; + entitlement ENT# vs CLAIM#; returns IAM policy&lt;br&gt;6&amp;nbsp;&amp;nbsp; API Lambda: flag = Y, age &amp;gt;= 30 days, version, lock&lt;br&gt;7&amp;nbsp;&amp;nbsp; Unchanged: return stored summary. Changed: enqueue&lt;br&gt;8&amp;nbsp;&amp;nbsp; Worker: snapshot to S3, Agent Engine via WIF&lt;br&gt;9&amp;nbsp;&amp;nbsp; Agent calls Gemini; trace logged&lt;br&gt;10&amp;nbsp;&amp;nbsp;Summary vN stored (append-only); lock released&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;INGEST PATH&lt;/font&gt;&lt;/b&gt;&lt;br&gt;A&amp;nbsp;&amp;nbsp; Streams capture changes to claim and role products&lt;br&gt;B&amp;nbsp;&amp;nbsp; Task runs only when stream has data; unloads to S3&lt;br&gt;C&amp;nbsp;&amp;nbsp; S3 event to SQS; Ingest Lambda processes the batch&lt;br&gt;D&amp;nbsp;&amp;nbsp; Upserts claim items and handler entitlement items&lt;br&gt;E&amp;nbsp;&amp;nbsp; Summaries to Snowflake through Snowpipe (reporting)&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;SECURITY BASELINE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;HIG pattern SPA_Internal_04; conformance on page 5&lt;br&gt;No internet path; private DNS; ACM TLS 1.2+; KMS CMKs&lt;br&gt;CloudTrail on; CloudWatch logs forwarded to Splunk&lt;br&gt;Service clients: same gateway, client-credential tokens&lt;br&gt;Dashed line: identity, config, error or optional&lt;br&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1310" y="620" width="360" height="490" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
