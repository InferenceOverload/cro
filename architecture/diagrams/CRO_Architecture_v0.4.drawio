        <mxCell id="db" value="&lt;b&gt;DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;CLAIM#&amp;lt;id&amp;gt;: eligibility, open date,&lt;br&gt;LOB, office, assigned adjuster&lt;br&gt;&lt;br&gt;ENT#&amp;lt;user&amp;gt;: role, LOB(s), office(s),&lt;br&gt;assigned claims, secured-claim access&lt;br&gt;&lt;br&gt;Two GetItems in the authorizer; cached&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#3B48CC;strokeWidth=2;fontSize=12;fontColor=#1A1A1A;fontFamily=Arial;" vertex="1" parent="aws">
