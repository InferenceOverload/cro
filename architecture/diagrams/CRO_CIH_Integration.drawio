        </mxCell>
        <mxCell id="_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.0000;exitY=0.7500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.7500;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="apic" target="med">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.0000;exitY=0.7500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.7500;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="med" target="cih">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_b0" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;html=1;aspect=fixed;fillColor=#1F4E79;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=11;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="139" y="241" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="_b1" value="&lt;b&gt;2&lt;/b&gt;" style="ellipse;html=1;aspect=fixed;fillColor=#1F4E79;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=11;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="259" y="285" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="_b2" value="&lt;b&gt;3&lt;/b&gt;" style="ellipse;html=1;aspect=fixed;fillColor=#1F4E79;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=11;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="609" y="285" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="_b3" value="&lt;b&gt;4&lt;/b&gt;" style="ellipse;html=1;aspect=fixed;fillColor=#1F4E79;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=11;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="889" y="285" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="_b4" value="&lt;b&gt;5&lt;/b&gt;" style="ellipse;html=1;aspect=fixed;fillColor=#1F4E79;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=11;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="609" y="335" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="_x0" value="&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;ENDPOINTS (v1, OpenAPI published)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;GET&amp;nbsp;&amp;nbsp;/claims/{claimId}/summary&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;latest summary, or 202 if generating&lt;br&gt;GET&amp;nbsp;&amp;nbsp;/claims/{claimId}/summary/versions&lt;br&gt;GET&amp;nbsp;&amp;nbsp;/claims/{claimId}/summary/{version}&lt;br&gt;POST /claims/{claimId}/summary&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;request (re)generation; 202 + job ref&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;RESPONSES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;200&amp;nbsp;&amp;nbsp;summary payload&lt;br&gt;202&amp;nbsp;&amp;nbsp;generation in progress; poll GET&lt;br&gt;404&amp;nbsp;&amp;nbsp;claim not flagged / not eligible&lt;br&gt;401 / 403&amp;nbsp;&amp;nbsp;caller not authorized&lt;br&gt;429&amp;nbsp;&amp;nbsp;quota exceeded (Apigee)&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;PAYLOAD&lt;/font&gt;&lt;/b&gt;&lt;br&gt;summaryText, version, generatedAt,&lt;br&gt;dataAsOf, claimDataVersion, stale (bool),&lt;br&gt;promptVersion, modelVersion, traceId&lt;br&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="50" y="515" width="400" height="375" as="geometry" />
        </mxCell>
        <mxCell id="_x1" value="&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;AUTHENTICATION AND AUTHORIZATION&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Caller: mediation layer service identity&lt;br&gt;&amp;nbsp;&amp;nbsp;Apigee API key + mTLS client certificate&lt;br&gt;&amp;nbsp;&amp;nbsp;(same front door as other EDS services)&lt;br&gt;No handler token crosses to CRO&lt;br&gt;CRO policy for this caller: read + request&lt;br&gt;&amp;nbsp;&amp;nbsp;generation only; no admin methods&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;HANDLER-LEVEL VISIBILITY&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Not applied in CRO (business scope: all&lt;br&gt;&amp;nbsp;&amp;nbsp;CRO-Handlers, all flagged claims). If CIH&lt;br&gt;&amp;nbsp;&amp;nbsp;needs claim-level rules, CIH enforces them.&lt;br&gt;Optional: mediation passes X-Handler-Id&lt;br&gt;&amp;nbsp;&amp;nbsp;for CRO audit logging only.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;AUDIT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Every call logged: caller, claim, version,&lt;br&gt;&amp;nbsp;&amp;nbsp;outcome, time; CloudWatch to Splunk.&lt;br&gt;Model inputs, outputs and traces retained&lt;br&gt;&amp;nbsp;&amp;nbsp;on the EDS side for compliance review.&lt;br&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="470" y="515" width="400" height="375" as="geometry" />
        </mxCell>
        <mxCell id="_x2" value="&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;FLOW&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1&amp;nbsp;&amp;nbsp;Handler opens a claim in CIH&lt;br&gt;2&amp;nbsp;&amp;nbsp;CIH asks mediation for the summary&lt;br&gt;3&amp;nbsp;&amp;nbsp;Mediation calls the Apigee product&lt;br&gt;4&amp;nbsp;&amp;nbsp;Apigee forwards to CRO; 200 or 202&lt;br&gt;5&amp;nbsp;&amp;nbsp;Response back via mediation to CIH&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;NON-FUNCTIONAL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Latency (targets, to validate): stored&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;lt; 500 ms p95; generation 30 to 90 s&lt;br&gt;Volume: on demand only; no bulk pull&lt;br&gt;Availability: tied to CRO metal tier&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;ONBOARDING STEPS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;a&amp;nbsp;&amp;nbsp;EDS publishes product + OpenAPI&lt;br&gt;b&amp;nbsp;&amp;nbsp;CIO subscribes mediation in Apigee&lt;br&gt;c&amp;nbsp;&amp;nbsp;Certificates exchanged; test in non-prod&lt;br&gt;d&amp;nbsp;&amp;nbsp;CIH integrates; interim CRO UI retired&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;OPEN QUESTIONS FOR CIO&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Pull on demand (this) or push on ready?&lt;br&gt;Does mediation carry handler identity?&lt;br&gt;Target PI for CIH to consume the API?&lt;br&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="890" y="515" width="370" height="375" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>