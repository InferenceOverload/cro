        <mxCell id="_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="med" target="apic">
