        <mxCell id="hd" value="&lt;b&gt;Claim handler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;Signed in to CIH;&lt;br&gt;CIH owns the screen&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=2;fontSize=12;fontColor=#1A1A1A;fontFamily=Arial;" vertex="1" parent="cio">
          <mxGeometry x="30" y="55" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cih" value="&lt;b&gt;Claims Insights Hub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;Renders the summary;&lt;br&gt;enforces which claims&lt;br&gt;a handler may see&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=2;fontSize=12;fontColor=#1A1A1A;fontFamily=Arial;" vertex="1" parent="cio">
          <mxGeometry x="30" y="150" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="med" value="&lt;b&gt;Mediation layer (CIO AWS)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;Registered Apigee consumer:&lt;br&gt;API key + client certificate (mTLS);&lt;br&gt;routes, retries, caches if desired&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;fontSize=12;fontColor=#1A1A1A;fontFamily=Arial;" vertex="1" parent="cio">
          <mxGeometry x="270" y="150" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="apic" value="&lt;b&gt;Apigee&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;CRO Summary API product;&lt;br&gt;subscription, quota, rate&lt;br&gt;limit, mTLS termination&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;fontSize=12;fontColor=#1A1A1A;fontFamily=Arial;" vertex="1" parent="eds">
          <mxGeometry x="40" y="150" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cro" value="&lt;b&gt;CRO Summary Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;Authenticates the calling service;&lt;br&gt;returns summaries for flagged claims&lt;br&gt;older than 30 days;&lt;br&gt;regenerates only when the claim&lt;br&gt;has changed since the last summary;&lt;br&gt;every summary versioned and auditable;&lt;br&gt;AI generation on Vertex AI Agent Engine&lt;br&gt;(traced for audit and compliance)&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#1A1A1A;fontFamily=Arial;" vertex="1" parent="eds">
          <mxGeometry x="280" y="55" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;CRO UI (interim)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;EDS handler screen until&lt;br&gt;CIH hosts the summary&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=2;fontSize=12;fontColor=#1A1A1A;fontFamily=Arial;" vertex="1" parent="eds">
          <mxGeometry x="40" y="55" width="200" height="60" as="geometry" />
        </mxCell>
