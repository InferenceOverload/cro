        </mxCell>
        <mxCell id="cio" value="&lt;b&gt;CIO-owned (Claims Insights Hub and mediation)&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#F7F8FA;strokeColor=#5F6B7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=14;fontColor=#5F6B7A;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="560" height="330" as="geometry" />
        </mxCell>
        <mxCell id="eds" value="&lt;b&gt;EDS Claims-owned (CRO service)&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FFFAF2;strokeColor=#FF9900;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=14;fontColor=#FF9900;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="640" height="330" as="geometry" />
        </mxCell>
        <mxCell id="ctr" value="&lt;b&gt;Integration contract (what CIH needs to know)&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#F7F8FA;strokeColor=#5F6B7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=14;fontColor=#5F6B7A;fontFamily=Arial;" vertex="1" parent="1">
